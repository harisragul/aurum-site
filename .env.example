# Live rate source (https://www.goldapi.io) - international gold converted to INR
GOLDAPI_KEY=
# Multiply the API price so it matches Chennai retail (import duty etc). Calibrate once, see README.
PREMIUM=1.0
# AI advisor (https://console.anthropic.com). Without a key, a rule-based advisor is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Lets you type in a rate by hand (POST /api/admin/rate) if the API is down
ADMIN_TOKEN=change-me
DB_PATH=gold.db
